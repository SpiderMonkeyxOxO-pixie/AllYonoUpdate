---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Icon from '../components/Icon.astro';
import { externalGuideUrl } from '../data/nav';
import { blogPosts } from '../data/blogPosts';
import { frontmatter as gamesListFrontmatter } from '../../content/blog/all-yono-games-list-2026.md';

const posts = [
  ...blogPosts.map((p) => ({
    title: p.title,
    summary: p.metaDescription,
    href: `/blog/${p.slug}/`,
    publishedDate: p.publishedDate,
    lastReviewedDate: p.lastReviewedDate,
  })),
  {
    title: gamesListFrontmatter.title,
    summary: gamesListFrontmatter.meta_description,
    href: `/blog/${gamesListFrontmatter.slug}/`,
    publishedDate: gamesListFrontmatter.date_published,
    lastReviewedDate: gamesListFrontmatter.date_modified,
  },
];

const blogRobots = posts.length > 0 ? 'index, follow' : 'noindex, follow';

const relatedCategories = [
  { label: 'Latest Promo Code', body: 'Tracks date-stamped release-period notices by platform.', href: '/promo-code-updates/' },
  { label: 'Latest Games', body: 'Browse the current recorded All Yono game directory.', href: '/all-yono-games/' },
  { label: 'Editorial Policy', body: 'See how articles are reviewed, revised, and corrected.', href: '/editorial-policy/' },
];

const faqs = [
  {
    question: 'How often are articles updated?',
    answer: 'Articles are revised when there is a meaningful change, correction, or clearer source of information. Every important update shows a visible last-reviewed date.',
  },
  {
    question: 'Where can I find longer evergreen guides?',
    answer: 'Longer reference guides are hosted on AllYonoOfficial.com and AllYonoIndia.com. This page tracks newly published and revised articles specific to AllYonoUpdate.com.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="All Yono Blog Updates: New Guides & Revised Articles"
  description="See new All Yono guides, revised articles, corrections, and refreshed information with clear publication and review dates in one update record."
  rawTitle
  ogTitle="All Yono Blog Updates: New Guides and Revised Articles"
  ogDescription="Browse newly published All Yono guides, revised articles, corrections, and refreshed information with visible update dates."
  robots={blogRobots}
  keywords={[
    'all yono blog updates',
    'all yono new articles',
    'all yono updated guides',
    'all yono revised articles',
    'all yono information updates',
    'all yono content updates',
    'all yono guide revisions',
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">All Yono Blog Updates</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-gray-300">
      This section tracks newly published and revised All Yono articles, each shown with a publication date and
      last-reviewed date.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#latest-blog-updates" class="rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
        View Latest Articles
      </a>
      <a href={externalGuideUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        Browse All Guides <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
      </a>
    </div>

    <p class="mt-6 max-w-3xl text-sm italic text-gray-400">
      AllYonoUpdate.com tracks editorial changes for reference. Article information may be revised when new
      details, corrections, or clearer explanations become available.
    </p>
  </section>

  <section id="latest-blog-updates" class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Latest Blog Updates</h2>
    <p class="mt-3 text-base leading-7 text-gray-300">
      The newest articles appear here first, each showing its headline, summary, publication date, and
      last-reviewed date.
    </p>

    {posts.length > 0 ? (
      <div class="mt-6 space-y-4">
        {posts.map((post) => (
          <a href={post.href} class="block rounded-lg border border-gray-800 bg-brand-surface/30 px-5 py-4 transition hover:border-gray-600">
            <h3 class="text-lg font-semibold text-brand-primary">{post.title}</h3>
            <p class="mt-1.5 text-sm leading-6 text-gray-300">{post.summary}</p>
            <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-400">
              <span>Published: {post.publishedDate}</span>
              <span>Last Reviewed: {post.lastReviewedDate}</span>
            </p>
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-6 rounded-lg border border-dashed border-gray-700 bg-brand-surface/50 px-6 py-10 text-center">
        <p class="text-base font-semibold text-gray-200">No New Blog Updates</p>
        <p class="mt-2 text-sm leading-6 text-gray-400">
          No new article has been published yet. Check back soon, or browse the latest game list and promo codes
          below.
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-3">
          <a href="/all-yono-games/" class="rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
            Browse Game List
          </a>
          <a href="/promo-code-updates/" class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
            View Latest Promo Codes
          </a>
        </div>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Browse Related Updates</h2>

    <ul class="mt-6 space-y-3">
      {relatedCategories.map((item) => (
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <a href={item.href} class="text-base font-semibold text-brand-accent-strong hover:underline">{item.label}</a>
          <span class="text-base leading-7 text-gray-300">{item.body}</span>
        </li>
      ))}
    </ul>

    <a href="/" class="mt-6 inline-block rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
      Back to Home
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <FaqAccordion faqs={faqs} />
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Note</h2>
      <p class="mt-3 text-sm leading-6 text-gray-200">
        AllYonoUpdate.com records blog and guide changes for general information purposes. Always review the
        publication date and last-reviewed date before relying on an article as current information.
      </p>
    </div>
  </section>
</Layout>
