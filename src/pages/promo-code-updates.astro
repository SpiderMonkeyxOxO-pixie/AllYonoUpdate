---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { gameLogos } from '../data/gameLogos';
import { getPromoCodes } from '../lib/promoCodes';
import { downloadUrls } from '../data/downloadUrls';

const promoCodes = getPromoCodes();
const logoByName = new Map(gameLogos.map((g) => [g.name, g.src]));
const downloadUrlByPlatform = new Map(downloadUrls.map((d) => [d.platform, d.url]));

const relatedCategories = [
  { label: 'All Yono Game List', body: 'Browse the current recorded game directory by category.', href: '/all-yono-games/' },
  { label: 'Blog Updates', body: 'Read newly published and revised All Yono articles.', href: '/blog-updates/' },
  { label: 'Editorial Policy', body: 'See how promo-code status notices are reviewed and labelled.', href: '/editorial-policy/' },
];

const faqs = [
  {
    question: 'How often are promo codes updated?',
    answer: 'Codes are entered manually up to three times a day — morning, afternoon, and evening — as each platform releases them.',
  },
  {
    question: 'Are promo codes active for the whole day?',
    answer: 'Not always. A code can change by release period, timing, app version, or platform notice. Check the morning, afternoon, and evening tabs for the latest value.',
  },
  {
    question: 'What does "Not released yet" mean?',
    answer: 'It means that platform has not published a code for that release period yet. Check back later or try a different tab.',
  },
  {
    question: 'Does AllYonoUpdate.com provide code support?',
    answer: 'No. This website is an informational tracker only. It does not handle account access, passwords, OTPs, payments, or private user concerns.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="All Yono Promo Code Status: Latest Release Updates"
  description="View date-stamped All Yono promo code status updates by morning, afternoon, and evening release periods, with clear availability and review notes for users."
  rawTitle
  ogTitle="All Yono Promo Code Status and Release Updates"
  ogDescription="Check date-stamped All Yono promo code status updates across morning, afternoon, and evening release periods."
  robots="index, follow"
  keywords={[
    'all yono promo code updates',
    'all yono promo code status',
    'all yono code update',
    'all yono morning code status',
    'all yono afternoon code status',
    'all yono evening code status',
    'all yono latest promo code update',
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">All Yono Promo Code Status Updates</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-gray-300">
      Browse the latest All Yono promo codes by platform, with a separate code for the morning, afternoon, and
      evening release periods.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#codes-by-platform" class="rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
        Jump to Codes by Platform
      </a>
      <a href="/all-yono-games/" class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        Browse Game List
      </a>
    </div>

    <p class="mt-6 max-w-3xl text-sm italic text-gray-400">
      AllYonoUpdate.com records information for reference only. It does not guarantee that a code will remain
      active, apply to every account, or work across all app versions.
    </p>
  </section>

  <section id="codes-by-platform" class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Daily Promo Codes by Platform</h2>
    <p class="mt-3 max-w-3xl text-base leading-7 text-gray-300">
      Codes below are entered manually up to three times a day — morning, afternoon, and evening — as each
      platform releases them. Tap Copy to copy a code to your clipboard.
    </p>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
      {promoCodes.map((entry) => (
        <div class="rounded-lg border border-brand-secondary bg-brand-surface p-3" data-tab-group>
          <div class="flex items-center gap-2">
            {logoByName.get(entry.platform) && (
              <img
                src={logoByName.get(entry.platform)}
                alt={`${entry.platform} logo`}
                width="28"
                height="28"
                loading="lazy"
                class="h-7 w-7 shrink-0 rounded-md object-contain"
              />
            )}
            <h3 class="truncate text-sm font-semibold text-brand-primary">{entry.platform}</h3>
          </div>

          <div class="mt-2 flex gap-1 rounded-md bg-brand-secondary p-0.5">
            {[
              { key: 'morning', label: 'AM', full: 'Morning' },
              { key: 'afternoon', label: 'PM', full: 'Afternoon' },
              { key: 'evening', label: 'Eve', full: 'Evening' },
            ].map((tab, i) => (
              <button
                type="button"
                data-tab-btn={tab.key}
                title={tab.full}
                class:list={[
                  'tab-btn min-w-0 flex-1 rounded-md py-1 text-center text-[10px] font-semibold transition sm:text-xs',
                  i === 0
                    ? 'bg-brand-accent/10 text-brand-accent border border-brand-accent/40'
                    : 'text-gray-500 hover:text-gray-300',
                ]}
              >
                {tab.label}
              </button>
            ))}
          </div>

          <div class="mt-2">
            {[
              { key: 'morning', label: 'Morning', code: entry.morning },
              { key: 'afternoon', label: 'Afternoon', code: entry.afternoon },
              { key: 'evening', label: 'Evening', code: entry.evening },
            ].map((row, i) => (
              <div
                data-tab-panel={row.key}
                class:list={['flex items-center justify-between gap-2 rounded-md bg-brand-secondary/30 px-2 py-1.5', i !== 0 && 'hidden']}
              >
                <div class="min-w-0">
                  <p class="text-[9px] font-medium text-gray-400">{row.label}</p>
                  <p class="truncate font-mono text-xs font-semibold text-brand-accent">{row.code || 'Not released yet'}</p>
                </div>
                {row.code && (
                  <button
                    type="button"
                    data-copy-code={row.code}
                    class="copy-btn shrink-0 rounded-md bg-brand-accent/10 px-2 py-1 text-[11px] font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20"
                  >
                    Copy
                  </button>
                )}
              </div>
            ))}
          </div>

          {downloadUrlByPlatform.get(entry.platform) && (
            <a
              href={downloadUrlByPlatform.get(entry.platform)}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="mt-2 block w-full rounded-md bg-emerald-600 px-2 py-1.5 text-center text-xs font-semibold text-white transition hover:bg-emerald-700"
            >
              Download
            </a>
          )}
        </div>
      ))}
    </div>

    <p class="mt-4 text-sm leading-6 text-gray-400">
      Codes are recorded for reference only. AllYonoUpdate.com does not guarantee a code remains active, applies
      to every account, or works across all app versions.
    </p>
    <p class="mt-2 text-sm leading-6 text-gray-400">
      Download links lead to each platform's own website. AllYonoUpdate.com does not operate these platforms and
      has not independently verified the bonus, code, or referral terms shown there.
    </p>
  </section>

  <script>
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const tabButton = target.closest('[data-tab-btn]');
      if (tabButton) {
        const group = tabButton.closest('[data-tab-group]');
        if (!group) return;
        const key = tabButton.getAttribute('data-tab-btn');
        group.querySelectorAll('[data-tab-btn]').forEach((btn) => {
          const active = btn === tabButton;
          btn.classList.toggle('bg-brand-accent/10', active);
          btn.classList.toggle('text-brand-accent', active);
          btn.classList.toggle('border', active);
          btn.classList.toggle('border-brand-accent/40', active);
          btn.classList.toggle('text-gray-500', !active);
          btn.classList.toggle('hover:text-gray-300', !active);
        });
        group.querySelectorAll('[data-tab-panel]').forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-tab-panel') !== key);
        });
        return;
      }

      const button = target.closest('[data-copy-code]');
      if (!button) return;
      const code = button.getAttribute('data-copy-code');
      if (!code) return;

      navigator.clipboard.writeText(code).then(() => {
        const original = button.textContent;
        button.textContent = 'Copied!';
        setTimeout(() => {
          button.textContent = original;
        }, 1500);
      });
    });
  </script>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Before You Rely on Any Code Update</h2>
      <p class="mt-3 text-sm leading-6 text-gray-200">
        Always check the date and time shown on the notice. Promo-code status can change based on release
        timing, app version, platform notices, or account-specific conditions.
      </p>
      <p class="mt-3 text-sm leading-6 text-gray-200">
        Do not assume an older code update is still current. A newer notice may replace it, revise it, or mark
        it as ended.
      </p>
      <p class="mt-3 text-sm font-medium leading-6 text-gray-200">
        This site does not request passwords, OTPs, payment details, or private account screenshots. Never share
        private information through unofficial contact routes.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Related Updates</h2>
    <p class="mt-3 text-base leading-7 text-gray-300">
      Promo-code notices can sometimes appear alongside broader platform changes.
    </p>

    <ul class="mt-6 space-y-3">
      {relatedCategories.map((item) => (
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <a href={item.href} class="text-base font-semibold text-brand-accent-strong hover:underline">{item.label}</a>
          <span class="text-base leading-7 text-gray-300">{item.body}</span>
        </li>
      ))}
    </ul>

    <a href="/" class="mt-6 inline-block rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
      Back to Home
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <FaqAccordion faqs={faqs} />
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Note</h2>
      <p class="mt-3 text-sm leading-6 text-gray-200">
        AllYonoUpdate.com records promo-code status information for general reference. Review the current
        status label, publication date, and last-reviewed time before relying on any release update.
      </p>
    </div>
  </section>
</Layout>
