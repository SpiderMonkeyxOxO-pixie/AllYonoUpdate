---
import Layout from '../layouts/Layout.astro';
import NoticeCard from '../components/NoticeCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { notices } from '../data/notices';
import { buildFaqSchema, buildBreadcrumbSchema } from '../lib/schema';

const appNotices = notices.filter((notice) => notice.category === 'App Changes');
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://allyonoupdate.com';

const statusLabels = [
  { label: 'Confirmed', body: 'The app change has been clearly documented through a reliable published source or direct observation inside the application.' },
  { label: 'Being Reviewed', body: 'A feature, layout change, or menu update has been reported or observed but still needs further verification.' },
  { label: 'Ended', body: 'A temporary layout change or earlier feature status is no longer current.' },
  { label: 'Archived', body: 'The record remains available as a dated reference but should not be treated as the current app state.' },
];

const relatedCategories = [
  { label: 'Latest Updates', body: 'Brings together all recent game, event, promo-code, and app notices in one feed.', href: '/latest-updates/' },
  { label: 'Game Updates', body: 'Records newly listed games, renamed titles, and availability notices.', href: '/game-updates/' },
  { label: 'Events & Notices', body: 'Covers scheduled notices, maintenance information, and event updates.', href: '/events-notices/' },
  { label: 'Promo Code Status', body: 'Records date-stamped availability notices by release period.', href: '/promo-code-updates/' },
];

const faqs = [
  {
    question: 'How often are app changes recorded?',
    answer: 'A notice is published when a meaningful, visible change can be documented. Each post shows when it was published and last reviewed.',
  },
  {
    question: 'Does every app change affect all users?',
    answer: 'Not always. Some changes may appear gradually, vary by app version, or affect only certain sections. Each update explains the known scope where possible.',
  },
  {
    question: 'What does "Being Reviewed" mean?',
    answer: 'It means the update has been reported or observed but has not yet been verified enough to be treated as confirmed.',
  },
  {
    question: 'Where can I find new game listings?',
    answer: 'Use the Game Updates section for newly listed titles, category adjustments, and availability changes.',
  },
];

const faqSchema = buildFaqSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: baseUrl },
  { name: 'App Updates', url: `${baseUrl}/app-updates/` },
]);
---

<Layout
  title="All Yono App Updates: UI, Features & Navigation"
  description="Track date-stamped All Yono app updates covering interface changes, features, menus, and navigation notices in one place."
  rawTitle
  ogTitle="All Yono App Updates: UI, Features and Navigation Changes"
  ogDescription="Browse dated All Yono app updates covering interface changes, features, menus, and navigation notices."
  robots="index, follow"
  keywords={[
    'all yono app updates',
    'all yono app changes',
    'all yono new features',
    'all yono navigation changes',
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">All Yono App Updates</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-gray-300">
      This section records visible changes inside All Yono applications — a redesigned menu, a moved setting, a
      new feature, or a navigation path that no longer appears where it used to.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-7 text-gray-300">
      Each update shows a publication date, last-reviewed date, and status label, so a current change is easy to
      separate from an older app version.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/latest-updates/" class="rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
        View Latest Updates
      </a>
      <a href="/game-updates/" class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        Browse Game Updates
      </a>
    </div>

    <p class="mt-6 max-w-3xl text-sm italic text-gray-400">
      AllYonoUpdate.com is an independent information tracker. App layouts and visible options can change after
      an update is published.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Latest App Changes</h2>
    <p class="mt-3 text-base leading-7 text-gray-300">
      The newest confirmed app changes appear here first, each showing its status, headline, summary,
      publication date, and last-reviewed date.
    </p>

    {appNotices.length > 0 ? (
      <div class="mt-6 space-y-4">
        {appNotices.map((notice) => <NoticeCard notice={notice} />)}
      </div>
    ) : (
      <div class="mt-6 rounded-lg border border-dashed border-gray-700 bg-brand-surface/50 px-6 py-10 text-center">
        <p class="text-base font-semibold text-gray-200">No New Confirmed App Changes</p>
        <p class="mt-2 text-sm leading-6 text-gray-400">
          No confirmed application changes have been recorded in this category yet. Browse the latest update
          feed for other recent changes.
        </p>
        <a href="/latest-updates/" class="mt-4 inline-block rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
          View Latest Updates
        </a>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">How App Update Status Labels Work</h2>
    <dl class="mt-6 space-y-4">
      {statusLabels.map((item) => (
        <div>
          <dt class="text-base font-semibold text-brand-primary">{item.label}</dt>
          <dd class="mt-1 text-base leading-7 text-gray-300">{item.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Related Updates</h2>
    <ul class="mt-6 space-y-3">
      {relatedCategories.map((item) => (
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <a href={item.href} class="text-base font-semibold text-brand-accent-strong hover:underline">{item.label}</a>
          <span class="text-base leading-7 text-gray-300">{item.body}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <FaqAccordion faqs={faqs} />
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Note</h2>
      <p class="mt-3 text-sm leading-6 text-gray-200">
        AllYonoUpdate.com records All Yono application changes for general reference. Review the publication
        date, last-reviewed date, and status label before relying on any app update.
      </p>
    </div>
  </section>
</Layout>
