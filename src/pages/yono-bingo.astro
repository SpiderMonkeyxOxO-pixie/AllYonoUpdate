---
import CategoryPage from '../components/CategoryPage.astro';
import { getCategoryMeta } from '../data/categories';
import { getAppsByCategory } from '../lib/apps';

const meta = getCategoryMeta('bingo');
const categoryApps = getAppsByCategory('bingo');

const faqs = [
  {
    question: 'Does AllYonoUpdate.com host any bingo-category APK files?',
    answer: 'No. AllYonoUpdate.com does not host or operate any APK files. Each Download button leads directly to the platform\'s own website.',
  },
  {
    question: 'Is Bingo 101 the same app as Ind Bingo?',
    answer: 'No. Bingo 101 and Ind Bingo are recorded as separate platforms, even though both are tracked under the bingo category.',
  },
  {
    question: 'How often is this bingo-category app list reviewed?',
    answer: 'The list is reviewed whenever a title is added, removed, renamed, or recategorized, so it reflects what was last recorded rather than a live feed.',
  },
];
---

<CategoryPage meta={meta} apps={categoryApps} faqs={faqs} />
