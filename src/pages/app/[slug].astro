---
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ComplianceNotice from '../../components/ComplianceNotice.astro';
import ComingSoonHighlight from '../../components/ComingSoonHighlight.astro';
import { buildSoftwareApplicationSchema, buildFaqSchema } from '../../lib/schema';
import { categories } from '../../data/categories';
import { apps, type AppEntry } from '../../lib/apps';
import { telegramUrl } from '../../data/nav';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props {
  app: AppEntry;
}

const { app } = Astro.props as { app: AppEntry };
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://allyonoupdate.com';

const categoryMeta = categories.find((c) => c.key === app.category) ?? categories.find((c) => c.key === 'all')!;

const h1 = `${app.name} APK: Download & Latest Version`;
const title = `${app.name} APK — Download & Latest Version`;
const schema = buildSoftwareApplicationSchema(app, baseUrl);

const faqs = app.faq.map((f) => ({ question: f.q, answer: f.a }));
const faqSchema = buildFaqSchema(faqs);

const hasSpecs = app.softwareVersion !== null || app.fileSize !== null || app.minAndroid !== null;
---

<Layout
  title={title}
  description={app.description}
  rawTitle
  ogTitle={title}
  ogDescription={app.description}
  robots="index, follow"
  keywords={[app.targetKeyword]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-3xl px-4 pt-16 pb-6 lg:px-8">
    <div class="flex items-center gap-4">
      <img src={app.icon} alt={`${app.name} logo`} width="72" height="72" loading="lazy" class="h-16 w-16 rounded-lg object-contain" />
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">{h1}</h1>
        <p class="text-sm text-gray-400">Last checked: {app.updated}</p>
      </div>
    </div>
  </section>

  {app.slug === 'dhan-game' && (
    <section class="mx-auto max-w-3xl px-4 pb-8 lg:px-8">
      <ComingSoonHighlight
        name={app.name}
        image={app.icon}
        releaseIso="2026-07-23T08:00:00+05:30"
        releaseDateLabel="July 23, 2026"
        releaseWindowLabel="8:00–9:00 AM IST"
        heading={`${app.name} is joining the All Yono directory`}
        description="This page will be updated with a recorded version, file size, and direct download link once DhanGame is available and can be independently reviewed."
        ctaLabel="Join Telegram for Launch Updates"
        ctaHref={telegramUrl}
      />
    </section>
  )}

  <section class="mx-auto max-w-3xl px-4 pb-8 lg:px-8">
    <p class="text-base leading-7 text-gray-300">{app.description}</p>

    {hasSpecs && (
      <dl class="mt-6 grid grid-cols-2 gap-4 rounded-lg border border-gray-800 bg-brand-surface/30 p-5 text-sm sm:grid-cols-4">
        {app.softwareVersion !== null && (
          <div>
            <dt class="text-gray-400">Version</dt>
            <dd class="mt-1 font-semibold text-brand-primary">{app.softwareVersion}</dd>
          </div>
        )}
        {app.fileSize !== null && (
          <div>
            <dt class="text-gray-400">File Size</dt>
            <dd class="mt-1 font-semibold text-brand-primary">{app.fileSize}</dd>
          </div>
        )}
        {app.minAndroid !== null && (
          <div>
            <dt class="text-gray-400">Android Requirement</dt>
            <dd class="mt-1 font-semibold text-brand-primary">{app.minAndroid}</dd>
          </div>
        )}
        <div>
          <dt class="text-gray-400">Category</dt>
          <dd class="mt-1 font-semibold text-brand-primary">{categoryMeta.h1.split(':')[0]}</dd>
        </div>
      </dl>
    )}

    <div class="mt-6 flex flex-wrap gap-3">
      {app.apkUrl && (
        <a href={app.apkUrl} target="_blank" rel="nofollow noopener noreferrer" class="rounded-md bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700">
          Download {app.name}
        </a>
      )}
      <a href={categoryMeta.path} class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        Browse {categoryMeta.h1.split(':')[0]}
      </a>
      <a href="/new-yono-games/" class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        See Latest Version Updates
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <FaqAccordion faqs={faqs} />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 lg:px-8">
    <ComplianceNotice />
  </section>
</Layout>
