---
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { buildSoftwareApplicationSchema, buildFaqSchema } from '../../lib/schema';
import { stateBanDisclaimer, categories } from '../../data/categories';
import { apps, type AppEntry } from '../../lib/apps';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props {
  app: AppEntry;
}

const { app } = Astro.props as { app: AppEntry };
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://allyonoupdate.com';

const categoryMeta = categories.find((c) => c.key === app.category) ?? categories.find((c) => c.key === 'all')!;

const title = `${app.name} APK Download — Latest Version`;
const description = `Download ${app.name} and see its recorded version, file size, Android requirement, and last-checked date in the All Yono directory.`;

const schema = buildSoftwareApplicationSchema(app, baseUrl);

const faqs = [
  {
    question: `Does AllYonoUpdate.com host the ${app.name} APK file?`,
    answer: `No. AllYonoUpdate.com does not host or operate any APK files. The Download button leads directly to ${app.name}'s own website, not to a file stored here.`,
  },
  {
    question: `Has AllYonoUpdate.com verified ${app.name}'s bonus or referral terms?`,
    answer: `No. AllYonoUpdate.com has not independently verified the bonus, code, or referral terms shown on ${app.name}'s own website.`,
  },
  {
    question: 'How often is this app record reviewed?',
    answer: 'This record is reviewed whenever a meaningful change can be confirmed, so the last-checked date reflects the most recent catalog check, not a live, real-time feed.',
  },
];
const faqSchema = buildFaqSchema(faqs);
---

<Layout
  title={title}
  description={description}
  rawTitle
  ogTitle={title}
  ogDescription={description}
  robots="index, follow"
  keywords={[app.name.toLowerCase(), `${app.name.toLowerCase()} apk`, `${app.name.toLowerCase()} download`]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-3xl px-4 pt-16 pb-6 lg:px-8">
    <div class="flex items-center gap-4">
      <img src={app.logo} alt={`${app.name} logo`} width="72" height="72" loading="lazy" class="h-16 w-16 rounded-lg object-contain" />
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">{app.name} APK Download</h1>
        <p class="text-sm text-gray-400">Last checked: {app.catalogReviewedDate}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-8 lg:px-8">
    <dl class="grid grid-cols-2 gap-4 rounded-lg border border-gray-800 bg-brand-surface/30 p-5 text-sm sm:grid-cols-4">
      <div>
        <dt class="text-gray-400">Version</dt>
        <dd class="mt-1 font-semibold text-brand-primary">{app.version ?? 'Not yet recorded'}</dd>
      </div>
      <div>
        <dt class="text-gray-400">File Size</dt>
        <dd class="mt-1 font-semibold text-brand-primary">{app.fileSize ?? 'Not yet recorded'}</dd>
      </div>
      <div>
        <dt class="text-gray-400">Android Requirement</dt>
        <dd class="mt-1 font-semibold text-brand-primary">{app.androidRequirement ?? 'Not yet recorded'}</dd>
      </div>
      <div>
        <dt class="text-gray-400">Category</dt>
        <dd class="mt-1 font-semibold text-brand-primary">{categoryMeta.h1.split(':')[0]}</dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href={app.downloadUrl} target="_blank" rel="nofollow noopener noreferrer" class="rounded-md bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700">
        Download {app.name}
      </a>
      <a href={categoryMeta.path} class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        Browse {categoryMeta.h1.split(':')[0]}
      </a>
      <a href="/new-yono-games/" class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        See Latest Version Updates
      </a>
    </div>

    <p class="mt-4 text-sm leading-6 text-gray-400">
      AllYonoUpdate.com does not host or operate {app.name}. The Download button leads directly to the platform's
      own website, and AllYonoUpdate.com has not independently verified its bonus, code, or referral terms.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <FaqAccordion faqs={faqs} />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 lg:px-8">
    <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">State Availability Notice</h2>
      <p class="mt-3 text-sm leading-6 text-gray-200">{stateBanDisclaimer}</p>
    </div>
  </section>
</Layout>
