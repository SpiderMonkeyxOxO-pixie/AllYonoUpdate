<Layout
  title="All Yono Update Disclaimer: Information Use Notice"
  description="Read the AllYonoUpdate.com disclaimer covering independent update records, dated information, third-party references, affiliate disclosure, and account-safety boundaries."
  rawTitle
  ogTitle="All Yono Update Disclaimer and Information Use Notice"
  ogDescription="Read how AllYonoUpdate.com presents dated update records, independent information, third-party references, and account-safety reminders."
  robots="index, follow"
  keywords={[
    'all yono update disclaimer',
    'all yono information disclaimer',
    'all yono update website disclaimer',
    'all yono independent tracker notice',
    'all yono update records notice',
  ]}
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">Disclaimer</h1>
    <p class="mt-3 text-sm font-medium text-gray-400">Last Updated: {lastUpdated}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
        Back to Home
      </a>
      <a href="/editorial-policy/" class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        Read Editorial Policy
      </a>
      <a href="/contact/" class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
        Contact All Yono Update
      </a>
    </div>
  </section>

  {sectionsPart1.map((section) => (
    <section class="mx-auto max-w-5xl px-4 py-6 lg:px-8">
      {section.highlight ? (
        <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
          <h2 class="text-lg font-bold text-brand-primary">{section.heading}</h2>
          {section.blocks.map((block) => (
            block.type === 'p' ? (
              <p class="mt-3 text-sm leading-6 text-gray-200">{block.text}</p>
            ) : (
              <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
                {block.items.map((item) => (
                  <li class="rounded-md border border-amber-500/30 bg-brand-surface px-4 py-2 text-sm text-gray-200">{item}</li>
                ))}
              </ul>
            )
          ))}
        </div>
      ) : (
        <>
          <h2 class="text-2xl font-bold tracking-tight text-brand-primary">{section.heading}</h2>
          {section.blocks.map((block) => (
            block.type === 'p' ? (
              <p class="mt-3 text-base leading-7 text-gray-300">{block.text}</p>
            ) : (
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-base leading-7 text-gray-300">
                {block.items.map((item) => <li>{item}</li>)}
              </ul>
            )
          ))}
        </>
      )}
    </section>
  ))}

  <section class="mx-auto max-w-5xl px-4 py-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">App-Specific Notices</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {appNotices.map((notice) => (
        <div class="rounded-lg border border-gray-800 bg-brand-surface p-5">
          <h3 class="text-base font-semibold text-brand-primary">{notice.heading}</h3>
          {notice.blocks.map((block) => (
            block.type === 'p' && <p class="mt-2 text-sm leading-6 text-gray-300">{block.text}</p>
          ))}
        </div>
      ))}
    </div>
  </section>

  {sectionsPart2.map((section) => (
    <section class="mx-auto max-w-5xl px-4 py-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-brand-primary">{section.heading}</h2>
      {section.blocks.map((block) => (
        block.type === 'p' ? (
          <p class="mt-3 text-base leading-7 text-gray-300">{block.text}</p>
        ) : (
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-base leading-7 text-gray-300">
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        )
      ))}
      {section.heading === 'Intellectual Property' && (
        <p class="mt-3 text-base leading-7 text-gray-300">
          Contact: <ProtectedEmail user={DISCLAIMER_EMAIL_USER} domain={DISCLAIMER_EMAIL_DOMAIN} />
        </p>
      )}
      {section.heading === 'Privacy and Personal Information' && (
        <a href="/privacy-policy/" class="mt-4 inline-block rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
          Read Privacy Policy
        </a>
      )}
    </section>
  ))}

  <section class="mx-auto max-w-5xl px-4 py-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Contact Us</h2>
    <p class="mt-3 text-base leading-7 text-gray-300">
      Questions, correction requests, legal notices or intellectual-property concerns relating to this Disclaimer may be sent to:
    </p>
    <p class="mt-4 text-base leading-7 text-gray-300">Website: AllYonoUpdate</p>
    <p class="mt-1 text-base leading-7 text-gray-300">Website Address: <a href="https://allyonoupdate.com/" class="font-semibold text-brand-accent-strong hover:underline">https://allyonoupdate.com/</a></p>
    <p class="mt-1 text-base leading-7 text-gray-300">
      Email: <ProtectedEmail user={DISCLAIMER_EMAIL_USER} domain={DISCLAIMER_EMAIL_DOMAIN} />
    </p>
    <a href="/contact/" class="mt-4 inline-block rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
      Send Editorial Feedback
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Reminder</h2>
      <p class="mt-3 text-sm leading-6 text-gray-200">
        By continuing to use AllYonoUpdate, you acknowledge that it is an independent informational update
        tracker. All third-party games, applications, events, promo codes, rewards, downloads and services
        remain under the ownership and responsibility of their respective operators.
      </p>
    </div>
  </section>
</Layout>
