---
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { buildFaqSchema, buildBlogPostingSchema, buildBreadcrumbSchema } from '../../lib/schema';
import { blogPosts, type BlogPost } from '../../data/blogPosts';

export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props as { post: BlogPost };
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://allyonoupdate.com';
const canonicalUrl = `${baseUrl}/blog/${post.slug}/`;

const faqSchema = buildFaqSchema(post.faqs);
const blogPostingSchema = buildBlogPostingSchema({
  headline: post.h1,
  description: post.metaDescription,
  datePublished: post.publishedDate,
  dateModified: post.lastReviewedDate,
  url: canonicalUrl,
  image: `${baseUrl}${post.image.src}`,
});
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: `${baseUrl}/` },
  { name: 'Blog Updates', url: `${baseUrl}/blog-updates/` },
  { name: post.h1, url: canonicalUrl },
]);

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// Paragraphs may contain simple [label](/path/) links for inline internal linking.
function renderInline(text: string): string {
  return escapeHtml(text).replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label, url) => (
    `<a href="${url}" class="font-semibold text-brand-accent-strong hover:underline">${label}</a>`
  ));
}
---

<Layout
  title={post.title}
  description={post.metaDescription}
  rawTitle
  ogTitle={post.title}
  ogDescription={post.metaDescription}
  ogImage={post.image.src}
  robots="index, follow"
  keywords={post.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="mx-auto max-w-3xl px-4 pt-16 pb-6 lg:px-8">
    <img
      src={post.image.src}
      alt={post.image.alt}
      width="1200"
      height="675"
      loading="eager"
      class="aspect-[16/9] w-full rounded-xl object-cover"
    />
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">{post.h1}</h1>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-400">
      <span>Published: {post.publishedDate}</span>
      <span>Last Reviewed: {post.lastReviewedDate}</span>
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-8 lg:px-8">
    {post.sections.map((section) => (
      <div class="mt-6 first:mt-0">
        <h2 class="text-xl font-bold tracking-tight text-brand-primary">{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p class="mt-3 text-base leading-7 text-gray-300" set:html={renderInline(paragraph)} />
        ))}
      </div>
    ))}

    <a href={post.relatedCategoryPath} class="mt-8 inline-block rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20">
      View Related Apps
    </a>

    {post.relatedArticles && post.relatedArticles.length > 0 && (
      <div class="mt-8">
        <h2 class="text-lg font-bold text-brand-primary">Related Reading</h2>
        <ul class="mt-3 space-y-2">
          {post.relatedArticles.map((related) => (
            <li>
              <a href={related.href} class="text-sm font-semibold text-brand-accent-strong hover:underline">{related.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <FaqAccordion faqs={post.faqs} />
  </section>
</Layout>
