---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from './FaqAccordion.astro';
import ComplianceNotice from './ComplianceNotice.astro';
import { buildCollectionPageSchema, buildFaqSchema } from '../lib/schema';
import { hubs, type HubMeta } from '../data/hubs';
import { sortNewestFirst, type AppEntry } from '../lib/apps';

interface Props {
  meta: HubMeta;
  apps: AppEntry[];
  faqs: { question: string; answer: string }[];
}

const { meta, apps, faqs } = Astro.props;
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://allyonoupdate.com';

const entries = sortNewestFirst(apps);
const collectionSchema = buildCollectionPageSchema(meta.title, meta.description, entries, baseUrl);
const faqSchema = buildFaqSchema(faqs);

const otherHubs = hubs.filter((h) => h.key !== meta.key);
---

<Layout
  title={meta.title}
  description={meta.description}
  rawTitle
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  robots="index, follow"
  keywords={meta.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-6 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">{meta.h1}</h1>
    <p class="mt-3 text-sm font-medium text-gray-400">Last updated: {entries[0]?.updated ?? 'Not yet recorded'}</p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-10 lg:px-8">
    <div class="divide-y divide-gray-800 rounded-lg border border-gray-800 bg-brand-surface/30">
      {entries.map((app) => (
        <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <img src={app.icon} alt={`${app.name} logo`} width="40" height="40" loading="lazy" class="h-10 w-10 shrink-0 rounded-md object-contain" />
            <div>
              <h3 class="text-sm font-semibold text-brand-primary">{app.name}</h3>
              <p class="text-xs text-gray-400">
                {app.softwareVersion !== null ? `Version: ${app.softwareVersion} · ` : ''}Updated: {app.updated}
              </p>
              <p class="mt-1 text-xs text-gray-400">{app.description}</p>
            </div>
          </div>
          <a href={app.url} class="shrink-0 rounded-md border border-gray-700 px-3 py-1.5 text-center text-xs font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100">
            View Details
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-8 lg:px-8">
    {meta.intro.split('\n\n').map((paragraph) => (
      <p class="mt-3 text-base leading-7 text-gray-300">{paragraph}</p>
    ))}
  </section>

  {otherHubs.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 py-8 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-brand-primary">More Update Hubs</h2>
      <ul class="mt-4 space-y-2">
        {otherHubs.map((hub) => (
          <li>
            <a href={hub.path} class="text-sm font-semibold text-brand-accent-strong hover:underline">{hub.h1}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-5xl px-4 py-8 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <FaqAccordion faqs={faqs} />
  </section>

  <section class="mx-auto max-w-5xl px-4 py-8 lg:px-8">
    <ComplianceNotice />
  </section>
</Layout>
