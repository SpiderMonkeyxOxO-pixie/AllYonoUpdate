---
import type { AppEntry } from '../lib/apps';

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
---

<div class="flex flex-col rounded-lg border border-brand-secondary bg-brand-surface p-4">
  <div class="flex items-center gap-3">
    <img
      src={app.logo}
      alt={`${app.name} logo`}
      width="56"
      height="56"
      loading="lazy"
      class="h-12 w-12 shrink-0 rounded-md object-contain"
    />
    <div class="min-w-0">
      <h3 class="truncate text-sm font-semibold text-brand-primary">{app.name}</h3>
      <p class="text-xs text-gray-400">Version: {app.version ?? 'Not yet recorded'}</p>
    </div>
  </div>

  <dl class="mt-3 grid grid-cols-2 gap-x-2 gap-y-1 text-xs text-gray-400">
    <div>
      <dt class="inline font-medium text-gray-300">Size:</dt>
      <dd class="inline">{app.fileSize ?? 'Not yet recorded'}</dd>
    </div>
    <div>
      <dt class="inline font-medium text-gray-300">Android:</dt>
      <dd class="inline">{app.androidRequirement ?? 'Not yet recorded'}</dd>
    </div>
    <div class="col-span-2">
      <dt class="inline font-medium text-gray-300">Last checked:</dt>
      <dd class="inline">{app.catalogReviewedDate}</dd>
    </div>
  </dl>

  <div class="mt-3 flex gap-2">
    <a
      href={`/app/${app.slug}/`}
      class="flex-1 rounded-md border border-gray-700 px-3 py-1.5 text-center text-xs font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100"
    >
      Details
    </a>
    <a
      href={app.downloadUrl}
      target="_blank"
      rel="nofollow noopener noreferrer"
      class="flex-1 rounded-md bg-emerald-600 px-3 py-1.5 text-center text-xs font-semibold text-white transition hover:bg-emerald-700"
    >
      Download
    </a>
  </div>
</div>
