---
import type { AppEntry } from '../lib/apps';

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
const hasSpecs = app.softwareVersion !== null || app.fileSize !== null || app.minAndroid !== null || app.rating !== null;
---

<div class="flex flex-col rounded-lg border border-brand-secondary bg-brand-surface p-4">
  <div class="flex items-center gap-3">
    <img
      src={app.icon}
      alt={`${app.name} logo`}
      width="56"
      height="56"
      loading="lazy"
      class="h-12 w-12 shrink-0 rounded-md object-contain"
    />
    <div class="min-w-0">
      <h3 class="truncate text-sm font-semibold text-brand-primary">{app.name}</h3>
      {app.rating !== null && <p class="text-xs text-gray-400">Rating: {app.rating.toFixed(1)}</p>}
    </div>
  </div>

  {hasSpecs && (
    <dl class="mt-3 grid grid-cols-2 gap-x-2 gap-y-1 text-xs text-gray-400">
      {app.softwareVersion !== null && (
        <div>
          <dt class="inline font-medium text-gray-300">Version:</dt>
          <dd class="inline">{app.softwareVersion}</dd>
        </div>
      )}
      {app.fileSize !== null && (
        <div>
          <dt class="inline font-medium text-gray-300">Size:</dt>
          <dd class="inline">{app.fileSize}</dd>
        </div>
      )}
      {app.minAndroid !== null && (
        <div>
          <dt class="inline font-medium text-gray-300">Android:</dt>
          <dd class="inline">{app.minAndroid}</dd>
        </div>
      )}
    </dl>
  )}

  <p class="mt-3 text-xs text-gray-400">Last checked: {app.updated}</p>

  <div class="mt-3 flex gap-2">
    <a
      href={app.url}
      class="flex-1 rounded-md border border-gray-700 px-3 py-1.5 text-center text-xs font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100"
    >
      Details
    </a>
    {app.apkUrl && (
      <a
        href={app.apkUrl}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="flex-1 rounded-md bg-emerald-600 px-3 py-1.5 text-center text-xs font-semibold text-white transition hover:bg-emerald-700"
      >
        Download
      </a>
    )}
  </div>
</div>
