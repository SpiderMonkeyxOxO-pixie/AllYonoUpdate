---
interface Props {
  heading: string;
  intro: string;
}

const { heading, intro } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16 lg:px-8">
  <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">{heading}</h1>
  <p class="mt-4 text-base leading-7 text-gray-300">{intro}</p>
  <div class="mt-8 rounded-lg border border-dashed border-gray-700 bg-brand-surface/50 px-6 py-10 text-center">
    <p class="text-sm font-medium text-gray-400">Content for this section is coming soon.</p>
    <p class="mt-1 text-sm text-gray-400">Check back shortly, or visit the <a href="/" class="font-medium text-brand-accent-strong hover:underline">Home</a> page.</p>
  </div>
</section>
