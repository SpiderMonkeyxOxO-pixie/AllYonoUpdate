---
import { compliance } from '../lib/apps';
---

<div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-6 py-6">
  <h2 class="text-lg font-bold text-brand-primary">State Availability &amp; Age Notice</h2>
  <p class="mt-3 text-sm font-medium leading-6 text-gray-200">{compliance.ageNotice}</p>
  <p class="mt-3 text-sm leading-6 text-gray-200">{compliance.restrictedStates}</p>
  <p class="mt-3 text-sm leading-6 text-gray-200">{compliance.disclaimer}</p>
</div>
