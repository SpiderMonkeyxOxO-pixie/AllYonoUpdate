---
import { footerColumns, aboutColumnLinks, bottomLinks, externalSites } from '../data/nav';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-gray-800 bg-brand-bg">
  <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-10 font-mono sm:grid-cols-3">
      <div>
        <a href="/" class="text-lg font-bold text-brand-accent">All Yono Update</a>
        <p class="mt-3 font-sans text-sm leading-6 text-gray-300">
          Date-stamped updates for All Yono promo codes, game listings, and blog articles.
        </p>
        <ul class="mt-4 space-y-2">
          {aboutColumnLinks.map((item) => (
            <li><a href={item.href} class="text-sm text-gray-300 hover:text-brand-accent">{item.label}</a></li>
          ))}
        </ul>

        <h3 class="mt-6 text-sm font-semibold text-brand-primary">More All Yono Sites</h3>
        <ul class="mt-4 space-y-2">
          {externalSites.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm text-gray-300 hover:text-brand-accent">
                {item.label} <Icon name="arrow-up-right" class="h-3 w-3" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-brand-primary">{column.heading}</h3>
          <ul class="mt-4 space-y-2">
            {column.links.map((item) => (
              <li><a href={item.href} class="text-sm text-gray-300 hover:text-brand-accent">{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 border-t border-gray-800 pt-6 font-mono">
      <p class="text-xs text-gray-400">
        &gt; © {year} AllYonoUpdate.com // 0x{year.toString(16).toUpperCase()}. Independent informational update tracker.
      </p>
      <p class="mt-2 font-sans text-xs leading-5 text-gray-400">
        Information is published for general reference and may change after posting. Review the date, update status, and source notes before relying on any notice.
      </p>
      <p class="mt-2 font-sans text-xs leading-5 text-gray-400">
        AllYonoUpdate.com does not provide account login, OTP support, password recovery, payment support, or private account assistance.
      </p>
      <p class="mt-2 font-sans text-xs leading-5 text-gray-400">
        AllYonoUpdate.com is not related or affiliated to Yono SBI or any related bank.
      </p>
      <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2" aria-label="Footer bottom">
        {bottomLinks.map((item, index) => (
          <>
            <a href={item.href} class="text-xs text-gray-400 hover:text-brand-accent">{item.label}</a>
            {index < bottomLinks.length - 1 && <span class="text-xs text-gray-700" aria-hidden="true">·</span>}
          </>
        ))}
      </nav>
    </div>
  </div>
</footer>
