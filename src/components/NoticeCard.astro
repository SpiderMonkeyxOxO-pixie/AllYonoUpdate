---
import type { Notice } from '../data/notices';
import Icon from './Icon.astro';

interface Props {
  notice: Notice;
}

const { notice } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-brand-secondary bg-brand-surface">
  {notice.image && (
    <img
      src={notice.image}
      alt={notice.imageAlt ?? notice.headline}
      width="1200"
      height="630"
      loading="lazy"
      class="aspect-[1.91/1] w-full object-cover"
    />
  )}

  <div class="px-5 py-5 sm:px-6 sm:py-6">
    <div class="flex flex-wrap gap-2">
      <span class="rounded-full bg-brand-secondary px-3 py-1 text-xs font-semibold text-brand-primary">{notice.status}</span>
      <span class="rounded-full border border-brand-secondary px-3 py-1 text-xs font-medium text-gray-300">{notice.category}</span>
      <span class="rounded-full border border-brand-secondary px-3 py-1 text-xs font-medium text-gray-300">{notice.updateType}</span>
    </div>

    <h3 class="mt-3 text-lg font-semibold text-brand-primary">{notice.headline}</h3>
    <p class="mt-2 text-sm leading-6 text-gray-300">{notice.summary}</p>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-400">
      <span>Published: {notice.publishedDate}</span>
      <span>Last Reviewed: {notice.lastReviewedDate}</span>
    </div>

    {notice.sourceUrl && (
      <div class="mt-4">
        <a
          href={notice.sourceUrl}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-accent-strong hover:underline"
        >
          View Source: {notice.sourceLabel} <Icon name="arrow-up-right" class="h-3 w-3" />
        </a>
        {notice.sourceVerified === false && (
          <p class="mt-1 text-xs text-gray-400">
            Third-party site. AllYonoUpdate.com has not verified its reward, code, or referral claims.
          </p>
        )}
      </div>
    )}
  </div>
</div>
