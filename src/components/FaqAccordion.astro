---
import Icon from './Icon.astro';

interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<div class="mt-6 divide-y divide-gray-800 rounded-lg border border-gray-800 bg-brand-surface/30">
  {faqs.map((faq) => (
    <details class="group px-4 py-4 sm:px-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-base font-semibold text-brand-primary marker:content-none">
        {faq.question}
        <Icon name="chevron-right" class="h-4 w-4 shrink-0 text-gray-500 transition-transform duration-200 group-open:rotate-90 group-open:text-brand-accent" />
      </summary>
      <p class="mt-3 text-base leading-7 text-gray-300">{faq.answer}</p>
    </details>
  ))}
</div>
