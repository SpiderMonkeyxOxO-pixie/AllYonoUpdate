---
import Icon from './Icon.astro';

interface Props {
  name: string;
  image: string;
  imageAlt?: string;
  releaseIso: string;
  releaseDateLabel: string;
  releaseWindowLabel: string;
  heading: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  status?: string;
  detailsHref?: string;
}

const {
  name,
  image,
  imageAlt = `${name} logo`,
  releaseIso,
  releaseDateLabel,
  releaseWindowLabel,
  heading,
  description,
  ctaLabel,
  ctaHref,
  status = 'Scheduled',
  detailsHref,
} = Astro.props;

const countdownUnits = [
  { unit: 'days', label: 'Days' },
  { unit: 'hours', label: 'Hrs' },
  { unit: 'minutes', label: 'Min' },
  { unit: 'seconds', label: 'Sec' },
];
---

<div class="overflow-hidden rounded-2xl border border-brand-accent/30 bg-brand-surface p-5 sm:p-7" data-countdown-card data-target={releaseIso}>
  <div class="flex flex-wrap items-center justify-between gap-4 sm:gap-6">
    <img
      src={image}
      alt={imageAlt}
      width="96"
      height="96"
      loading="lazy"
      class="h-16 w-16 shrink-0 rounded-xl object-cover ring-1 ring-brand-secondary sm:h-20 sm:w-20"
    />

    <div class="flex gap-2" aria-hidden="true">
      {countdownUnits.map(({ unit, label }) => (
        <div class="flex w-14 flex-col items-center rounded-lg border border-brand-secondary bg-brand-bg px-1.5 py-2 sm:w-16 sm:py-2.5">
          <span class="font-mono text-lg font-bold text-brand-primary sm:text-xl" data-countdown-value={unit}>--</span>
          <span class="mt-0.5 text-[9px] font-medium uppercase tracking-wide text-gray-400 sm:text-[10px]">{label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <span class="rounded-full bg-brand-accent/10 px-3 py-1 text-[10px] font-bold uppercase tracking-wide text-brand-accent border border-brand-accent/40">
      Coming Soon
    </span>
    <span class="rounded-full border border-brand-secondary bg-brand-secondary/60 px-3 py-1 text-[10px] font-semibold text-gray-300">
      {status}
    </span>
  </div>

  <h2 class="mt-3 text-xl font-bold tracking-tight text-brand-primary sm:text-2xl">{heading}</h2>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-300 sm:text-base">{description}</p>
  <p class="mt-2 text-xs font-medium text-gray-400">Expected launch: {releaseDateLabel}, {releaseWindowLabel}</p>

  <div class="mt-4 flex flex-wrap gap-3">
    <a
      href={ctaHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-md bg-brand-accent/10 px-5 py-2.5 text-sm font-semibold text-brand-accent border border-brand-accent/50 transition hover:bg-brand-accent/20"
    >
      {ctaLabel} <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
    </a>
    {detailsHref && (
      <a
        href={detailsHref}
        class="rounded-md border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 transition hover:border-gray-500 hover:text-gray-100"
      >
        View Details
      </a>
    )}
  </div>
</div>

<script>
  function updateCountdownCards() {
    const cards = document.querySelectorAll('[data-countdown-card]');
    cards.forEach((card) => {
      const target = card.getAttribute('data-target');
      if (!target) return;
      const diff = Math.max(new Date(target).getTime() - Date.now(), 0);
      const values = {
        days: Math.floor(diff / 86400000),
        hours: Math.floor((diff % 86400000) / 3600000),
        minutes: Math.floor((diff % 3600000) / 60000),
        seconds: Math.floor((diff % 60000) / 1000),
      };
      card.querySelectorAll('[data-countdown-value]').forEach((el) => {
        const unit = el.getAttribute('data-countdown-value');
        if (unit && unit in values) {
          el.textContent = String(values[unit]).padStart(2, '0');
        }
      });
    });
  }

  updateCountdownCards();
  setInterval(updateCountdownCards, 1000);
</script>
