---
import Layout from '../layouts/Layout.astro';

const mainSections = [
  { section: 'Home', covers: 'Latest overview of All Yono game, event, app, and promo-code changes', href: '/' },
  { section: 'Latest Updates', covers: 'Newest recorded notices across all update categories', href: '/latest-updates/' },
  { section: 'Game Updates', covers: 'New listings, renamed games, category changes, and availability notices', href: '/game-updates/' },
  { section: 'Promo Code Status', covers: 'Morning, afternoon, and evening release-status records', href: '/promo-code-updates/' },
  { section: 'Events & Notices', covers: 'Event updates, maintenance information, schedule changes, and temporary notices', href: '/events-notices/' },
  { section: 'App Changes', covers: 'UI updates, feature changes, menu adjustments, settings changes, and navigation updates', href: '/app-updates/' },
  { section: 'All Yono Game List', covers: 'Current recorded game directory, new entries, and category information', href: '/all-yono-games/' },
  { section: 'Blog Updates', covers: 'New articles, revised guides, corrections, and archived editorial records', href: '/blog-updates/' },
];

const archiveSections = [
  { section: 'Update Archive', covers: 'Earlier dated notices organised by category, with monthly archiving added as updates are published', href: '/update-archive/' },
];

const editorialSections = [
  { section: 'About All Yono Update', covers: 'The purpose and independent role of this update tracker', href: '/about/' },
  { section: 'How Updates Are Reviewed', covers: 'Status labels, review process, revisions, and archive approach', href: '/editorial-policy/' },
  { section: 'Correction Policy', covers: 'How public correction requests are reviewed and handled', href: '/correction-policy/' },
  { section: 'Contact', covers: 'Editorial feedback, correction requests, and website questions', href: '/contact/' },
];

const policySections = [
  { section: 'Disclaimer', covers: 'Information-use limits, third-party references, and account-safety boundaries', href: '/disclaimer/' },
  { section: 'Privacy Policy', covers: 'Website data, contact-form information, cookies, and privacy requests', href: '/privacy-policy/' },
  { section: 'Terms of Use', covers: 'Website access rules, content-use limits, and acceptable-use terms', href: '/terms-of-use/' },
  { section: 'Cookie Policy', covers: 'Essential, preference, and analytics cookie information', href: '/cookie-policy/' },
];

const referenceSections = [
  { section: 'All Yono App Guide', covers: 'Quick reference for navigating the All Yono app', href: '/app-guide/' },
  { section: 'All Yono Game Information', covers: 'Reference information about games available on All Yono', href: '/game-information/' },
  { section: 'Common Questions', covers: 'Frequently asked questions about All Yono updates and this tracker', href: '/common-questions/' },
];

const tableGroups = [
  { heading: 'Main Update Sections', rows: mainSections },
  { heading: 'Archive', rows: archiveSections },
  { heading: 'Information and Editorial Pages', rows: editorialSections },
  { heading: 'Website Policies', rows: policySections },
  { heading: 'Helpful References', rows: referenceSections },
];
---

<Layout
  title="All Yono Update Sitemap: Find Updates and Guides"
  description="Browse all AllYonoUpdate.com sections, including latest updates, game records, promo code status, events, app changes, archives, policies, and contact details."
  rawTitle
  ogTitle="All Yono Update Sitemap: Browse Website Sections"
  ogDescription="Find all All Yono Update sections, including game updates, promo-code status, events, app changes, archives, policies, and contact details."
  robots="index, follow"
  keywords={[
    'all yono update sitemap',
    'all yono website sitemap',
    'all yono updates directory',
    'all yono update categories',
    'all yono site navigation',
  ]}
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">All Yono Update Sitemap</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      Use this sitemap to browse all major sections of AllYonoUpdate.com.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      The site is organised around date-stamped game changes, promo-code status notices, event updates,
      application changes, newly recorded game listings, and archived information. Each section below links to
      a different part of the website.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/latest-updates/" class="rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
        View Latest Updates
      </a>
      <a href="/all-yono-games/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
        Browse All Yono Game List
      </a>
    </div>
  </section>

  {tableGroups.map((group) => (
    <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-brand-primary">{group.heading}</h2>

      <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-3 font-semibold text-brand-primary">Section</th>
              <th class="px-4 py-3 font-semibold text-brand-primary">What You Will Find</th>
              <th class="px-4 py-3 font-semibold text-brand-primary">Link</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {group.rows.map((row) => (
              <tr>
                <td class="px-4 py-3 font-medium text-slate-700">{row.section}</td>
                <td class="px-4 py-3 text-slate-600">{row.covers}</td>
                <td class="px-4 py-3">
                  <a href={row.href} class="font-medium text-brand-accent-strong hover:underline">{row.href}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Find the Latest Information</h2>
    <p class="mt-3 text-base leading-7 text-slate-600">For current notices, begin with Latest Updates.</p>
    <p class="mt-3 text-base leading-7 text-slate-600">For a current game-directory overview, use All Yono Game List.</p>
    <p class="mt-3 text-base leading-7 text-slate-600">For older records, dates, and earlier changes, use the Update Archive.</p>
    <p class="mt-3 text-base leading-7 text-slate-600">
      Every update should show a publication date, last-reviewed date, category, and status label so older
      information is not confused with the latest available record.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Note</h2>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        AllYonoUpdate.com is an independent informational update tracker. Game listings, event notices,
        promo-code status, application features, and interface layouts may change after an update is published.
      </p>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        Review the latest dated notice and its status label before relying on any older record.
      </p>
    </div>
  </section>
</Layout>
