---
import Layout from '../layouts/Layout.astro';
import NoticeCard from '../components/NoticeCard.astro';
import { notices } from '../data/notices';

const categoryNotices = notices.filter((notice) => notice.category === 'Events & Notices');

const noticeTypes = [
  {
    heading: 'Event Updates',
    body: [
      'Event updates record time-limited activities, announced schedules, changes to event information, or notices that affect one or more game sections.',
      'Each event post should make the active period easy to understand. Where an end date is known, show it clearly. Where no end date has been confirmed, state that the notice remains under review.',
    ],
    cta: 'View Event Updates',
    href: '#current-events-notices',
  },
  {
    heading: 'Maintenance Notices',
    body: [
      'Maintenance notices record reported or confirmed periods when a game section, feature, or application area may be unavailable, loading differently, or temporarily adjusted.',
      'A maintenance post should never suggest that access will return at a specific time unless that timing has been clearly announced. Use direct wording such as "timing not yet confirmed" when no reliable schedule is available.',
    ],
    cta: 'View Maintenance Notices',
    href: '#current-events-notices',
  },
  {
    heading: 'Schedule Changes',
    body: [
      'Schedule-change notices cover revised event timing, shifted release windows, updated dates, postponed activities, or changes to a previously published timetable.',
      'The newer notice should always link back to the earlier update where relevant, so readers can see what changed instead of relying on outdated information.',
    ],
    cta: 'View Schedule Updates',
    href: '#current-events-notices',
  },
  {
    heading: 'Temporary Platform Changes',
    body: [
      'Some notices may involve a short-term change to a game category, app section, visible option, or release-status board. These should be marked clearly as temporary unless there is a confirmed permanent update.',
      'Each post should state the date the change was first observed and whether the situation is still active, ended, or being reviewed.',
    ],
    cta: 'View Temporary Updates',
    href: '#current-events-notices',
  },
];

const noticeLabels = [
  { label: 'Confirmed', body: 'The event, schedule, or temporary platform change has been documented through a reliable source or clear application observation.' },
  { label: 'Being Reviewed', body: 'Information has been reported or noticed but requires more verification before it is treated as confirmed.' },
  { label: 'Upcoming', body: 'The notice relates to a future date or planned change.' },
  { label: 'Active', body: 'The notice is currently relevant based on the latest available information.' },
  { label: 'Ended', body: 'The event, maintenance window, temporary change, or notice is no longer current.' },
];

const relatedCategories = [
  { label: 'Latest Updates', body: 'Combines all newly recorded notices in one chronological feed.', href: '/latest-updates/' },
  { label: 'Game Updates', body: 'Records new listings, category adjustments, renamed games, and availability changes.', href: '/game-updates/' },
  { label: 'Promo Code Status', body: 'Tracks date-stamped release-period information.', href: '/promo-code-updates/' },
  { label: 'App Changes', body: 'Records new features, updated menus, redesigned sections, and navigation changes inside the application.', href: '/app-updates/' },
];

const faqs = [
  {
    question: 'How often are event notices updated?',
    answer: 'Notices should be published or revised when there is a meaningful and documented change. Each post should show its publication date and last-reviewed date.',
  },
  {
    question: 'Does an event notice stay current after the event ends?',
    answer: 'No. Once the relevant period has passed, the notice should be labelled Ended and moved into the archive while remaining available for reference.',
  },
  {
    question: 'What does "Being Reviewed" mean?',
    answer: 'It means the information has been reported or observed but is not yet verified enough to be presented as confirmed.',
  },
  {
    question: 'Why did an event schedule change?',
    answer: 'Schedules can change because of revised platform announcements, maintenance, feature changes, or other temporary updates. The newest dated notice should explain what changed from the earlier information.',
  },
  {
    question: 'Where can I find app feature updates?',
    answer: 'Use the App Changes section for interface, menu, setting, and feature updates inside the application.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="All Yono Events & Notices: Latest Platform Updates"
  description="Read date-stamped All Yono event notices, maintenance updates, schedule changes, and temporary platform information with clear review status labels today."
  rawTitle
  ogTitle="All Yono Events, Notices and Temporary Updates"
  ogDescription="Browse dated All Yono event notices, schedule updates, maintenance information, and temporary platform changes."
  robots="index, follow"
  keywords={[
    'all yono events',
    'all yono event updates',
    'all yono notices',
    'all yono maintenance update',
    'all yono schedule updates',
    'all yono platform notices',
    'all yono temporary updates',
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">All Yono Events and Notices</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      This section records date-stamped All Yono event notices, maintenance information, schedule changes,
      temporary access updates, and other important platform announcements.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      Some notices may only apply for a limited period. That is why every update should show its publication
      date, last-reviewed date, verification status, and current timing label.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/latest-updates/" class="rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
        View Latest Updates
      </a>
      <a href="/game-updates/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
        Browse Game Updates
      </a>
    </div>

    <p class="mt-6 max-w-3xl text-sm italic text-slate-500">
      AllYonoUpdate.com is an independent information tracker. Event schedules, availability, and temporary
      notices can change after publication.
    </p>
  </section>

  <section id="current-events-notices" class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Current Events and Notices</h2>
    <p class="mt-3 text-base leading-7 text-slate-600">
      This area displays the most recent active or upcoming notices first, each showing its verification status,
      timing status, category, headline, summary, publication date, and last-reviewed date.
    </p>

    {categoryNotices.length > 0 ? (
      <div class="mt-6 space-y-4">
        {categoryNotices.map((notice) => <NoticeCard notice={notice} />)}
      </div>
    ) : (
      <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
        <p class="text-base font-semibold text-slate-700">No Active Notices Right Now</p>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          No active confirmed event or platform notice has been recorded at this time. You can review earlier
          notices in the archive or browse the latest update feed.
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-3">
          <a href="/latest-updates/" class="rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
            View Latest Updates
          </a>
          <a href="/update-archive/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
            Open Update Archive
          </a>
        </div>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Browse Notice Types</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {noticeTypes.map((type) => (
        <div class="flex flex-col rounded-lg border border-slate-200 bg-white px-5 py-6">
          <h3 class="text-base font-semibold text-brand-primary">{type.heading}</h3>
          {type.body.map((paragraph) => (
            <p class="mt-2 text-sm leading-6 text-slate-600">{paragraph}</p>
          ))}
          <a href={type.href} class="mt-4 text-sm font-semibold text-brand-accent-strong hover:underline">{type.cta} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">How Notice Labels Work</h2>

    <dl class="mt-6 space-y-4">
      {noticeLabels.map((item) => (
        <div>
          <dt class="text-base font-semibold text-brand-primary">{item.label}</dt>
          <dd class="mt-1 text-base leading-7 text-slate-600">{item.body}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-4 text-base leading-7 text-slate-600">
      These labels should remain visible on every notice card so older information is not mistaken for a live
      update.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Before Relying on an Event Notice</h2>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        Read the date, time, and status label before relying on any event or temporary update. A newer notice
        may revise the schedule, confirm a change, or mark an earlier update as ended.
      </p>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        Where possible, each notice should include a visible source note or a short explanation of how the
        update was reviewed. This keeps the feed clear and helps readers understand whether information is
        confirmed or still developing.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Related Update Sections</h2>

    <ul class="mt-6 space-y-3">
      {relatedCategories.map((item) => (
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <a href={item.href} class="text-base font-semibold text-brand-accent-strong hover:underline">{item.label}</a>
          <span class="text-base leading-7 text-slate-600">{item.body}</span>
        </li>
      ))}
    </ul>

    <a href="/latest-updates/" class="mt-6 inline-block rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
      View Latest Updates
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <div class="mt-6 space-y-6">
      {faqs.map((faq) => (
        <div>
          <h3 class="text-base font-semibold text-brand-primary">{faq.question}</h3>
          <p class="mt-2 text-base leading-7 text-slate-600">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Note</h2>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        AllYonoUpdate.com records event and notice information for general reference. Review the update status,
        publication date, last-reviewed date, and active period before relying on any listed event, schedule, or
        temporary platform notice.
      </p>
    </div>
  </section>
</Layout>
