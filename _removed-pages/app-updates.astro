---
import Layout from '../layouts/Layout.astro';

const updateTypes = [
  {
    heading: 'User Interface Updates',
    body: [
      'User interface updates record visible design or layout changes inside the application.',
      'This may include a new home-screen arrangement, revised icons, updated colours, moved sections, adjusted buttons, redesigned game categories, or a different way of viewing platform notices.',
      'A UI update should explain the practical change, not just say that the app "looks new." For example, users should be told whether a section moved from the home screen into a menu, whether a category label changed, or whether a feature now appears in a different location.',
    ],
    cta: 'View UI Updates',
    href: '#latest-app-changes',
  },
  {
    heading: 'New Features and Feature Changes',
    body: [
      'This area records newly visible tools, added options, revised functions, or changes to features that already existed inside the application.',
      'A post may cover a new notice board, a revised game filter, an added search option, a changed profile setting, or a feature that now works differently than before.',
      'When a feature appears to be new but is not fully confirmed across all versions, label the update as Being Reviewed until there is enough information to present it as confirmed.',
    ],
    cta: 'View Feature Updates',
    href: '#latest-app-changes',
  },
  {
    heading: 'Menu and Navigation Changes',
    body: [
      'Navigation changes can affect how users move between the home area, game categories, events, notices, settings, and other visible sections.',
      'This category should record moved menus, renamed tabs, changed category paths, new navigation icons, or sections that are no longer shown in their previous location.',
      'Each notice should state the old path and the newly recorded path where possible. That small detail makes an update much more useful than a vague note about a menu change.',
    ],
    cta: 'View Navigation Updates',
    href: '#latest-app-changes',
  },
  {
    heading: 'Settings and Account Area Changes',
    body: [
      'Settings changes cover visible adjustments to options that may appear in the profile, preferences, notification area, or other account-related sections inside the application.',
      'Updates in this category should focus on what users can see or manage. They should not request private details, account credentials, passwords, OTPs, or screenshots.',
      'Where a setting has moved, explain the latest recorded path in a clear format.',
    ],
    fields: ['Previous location', 'Current recorded location', 'Status'],
    cta: 'View Settings Updates',
    href: '#latest-app-changes',
  },
  {
    heading: 'Performance and Loading Notices',
    body: [
      'Some application changes may affect loading speed, screen behaviour, game-category visibility, or how a feature responds after an update.',
      'These notices should remain factual. Record what was observed, when it was observed, and whether the issue appears temporary or linked to a specific app version. Do not promise a fix time unless a confirmed notice provides one.',
    ],
    cta: 'View Performance Notices',
    href: '#latest-app-changes',
  },
];

const statusLabels = [
  { label: 'Confirmed', body: 'The app change has been clearly documented through a reliable published source or direct observation inside the application.' },
  { label: 'Being Reviewed', body: 'A feature, layout change, or menu update has been reported or observed but still needs further verification.' },
  { label: 'Ended', body: 'A temporary layout change, short-term notice, or earlier feature status is no longer current.' },
];

const relatedCategories = [
  { label: 'Latest Updates', body: 'Brings together all recent game, feature, event, promo-code, and app notices in one feed.', href: '/latest-updates/' },
  { label: 'Game Updates', body: 'Records newly listed games, category changes, renamed titles, and availability notices.', href: '/game-updates/' },
  { label: 'Events & Notices', body: 'Covers scheduled notices, maintenance information, temporary changes, and event updates.', href: '/events-notices/' },
  { label: 'Promo Code Status', body: 'Records date-stamped availability notices by release period.', href: '/promo-code-updates/' },
];

const faqs = [
  {
    question: 'How often are app changes recorded?',
    answer: 'A notice should be published when a meaningful visible change can be documented. Each post should show when it was published and last reviewed.',
  },
  {
    question: 'Why does the app look different from an earlier update?',
    answer: 'The application may have received a layout adjustment, feature rollout, version change, or temporary interface update. Check the newest confirmed app-change notice first.',
  },
  {
    question: 'Does every app change affect all users?',
    answer: 'Not always. Some changes may appear gradually, vary by app version, or affect only certain sections. Each update should explain the known scope where possible.',
  },
  {
    question: 'What does "Being Reviewed" mean?',
    answer: 'It means the update has been reported or observed but has not yet been verified enough to be treated as confirmed.',
  },
  {
    question: 'Where can I find new game listings?',
    answer: 'Use the Game Updates section for newly listed titles, game category adjustments, renamed games, and availability changes.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="All Yono App Updates: UI, Features & Navigation"
  description="Track date-stamped All Yono app updates covering new UI layouts, feature changes, menu adjustments, settings updates, and navigation notices in one place."
  rawTitle
  ogTitle="All Yono App Updates: UI, Features and Navigation Changes"
  ogDescription="Browse dated All Yono app updates covering interface changes, features, menus, settings, and navigation notices."
  robots="index, follow"
  keywords={[
    'all yono app updates',
    'all yono app changes',
    'all yono new features',
    'all yono UI updates',
    'all yono navigation changes',
    'all yono menu updates',
    'all yono feature updates',
    'all yono settings updates',
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">All Yono App Updates, UI Changes and New Features</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      This section records visible changes inside the All Yono application. That may include a redesigned menu,
      a moved setting, a new feature, an updated game category, a changed navigation path, or an option that no
      longer appears where it used to.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      The purpose is straightforward: help users understand what changed, when it was first recorded, and
      whether the information has been confirmed.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      Each update should show a publication date, last-reviewed date, category, and status label. This makes it
      easier to separate a current change from an older app version or a temporary layout adjustment.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/latest-updates/" class="rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
        View Latest Updates
      </a>
      <a href="/game-updates/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
        Browse Game Updates
      </a>
    </div>

    <p class="mt-6 max-w-3xl text-sm italic text-slate-500">
      AllYonoUpdate.com is an independent information tracker. App layouts, features, and visible options can
      change after an update is published.
    </p>
  </section>

  <section id="latest-app-changes" class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Latest App Changes</h2>
    <p class="mt-3 text-base leading-7 text-slate-600">
      The newest confirmed app changes appear here first, each showing its status, update type, headline,
      summary, publication date, and last-reviewed date.
    </p>

    <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
      <p class="text-base font-semibold text-slate-700">No New Confirmed App Changes</p>
      <p class="mt-2 text-sm leading-6 text-slate-500">
        No new confirmed application changes have been recorded at this time. Browse the latest update feed or
        review earlier notices in the archive.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href="/latest-updates/" class="rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
          View Latest Updates
        </a>
        <a href="/update-archive/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
          Open Update Archive
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Browse Update Types</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {updateTypes.map((type) => (
        <div class="flex flex-col rounded-lg border border-slate-200 bg-white px-5 py-6">
          <h3 class="text-base font-semibold text-brand-primary">{type.heading}</h3>
          {type.body.map((paragraph) => (
            <p class="mt-2 text-sm leading-6 text-slate-600">{paragraph}</p>
          ))}
          {type.fields && (
            <dl class="mt-3 space-y-1 rounded-md border border-slate-200 bg-slate-50 px-3 py-2">
              {type.fields.map((field) => (
                <div class="flex justify-between gap-2 text-xs text-slate-500">
                  <dt class="font-medium text-slate-600">{field}</dt>
                  <dd>—</dd>
                </div>
              ))}
            </dl>
          )}
          <a href={type.href} class="mt-4 text-sm font-semibold text-brand-accent-strong hover:underline">{type.cta} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">How App Update Status Labels Work</h2>

    <dl class="mt-6 space-y-4">
      {statusLabels.map((item) => (
        <div>
          <dt class="text-base font-semibold text-brand-primary">{item.label}</dt>
          <dd class="mt-1 text-base leading-7 text-slate-600">{item.body}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-4 text-base leading-7 text-slate-600">
      Every app update should retain its original publication date. When an older update is replaced, add a
      revision note or publish a newer dated notice rather than silently changing the original record.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Why Dates Matter</h2>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        All Yono application changes may appear differently depending on the version, timing, device, or
        rollout stage. A menu that looks one way today may move later, and a visible feature may not appear for
        every user at the same time.
      </p>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        That is why the date and status label should always be visible. The latest confirmed notice should take
        priority over an older app-change post.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Related Updates</h2>

    <ul class="mt-6 space-y-3">
      {relatedCategories.map((item) => (
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <a href={item.href} class="text-base font-semibold text-brand-accent-strong hover:underline">{item.label}</a>
          <span class="text-base leading-7 text-slate-600">{item.body}</span>
        </li>
      ))}
    </ul>

    <a href="/latest-updates/" class="mt-6 inline-block rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
      View Latest Updates
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <div class="mt-6 space-y-6">
      {faqs.map((faq) => (
        <div>
          <h3 class="text-base font-semibold text-brand-primary">{faq.question}</h3>
          <p class="mt-2 text-base leading-7 text-slate-600">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Note</h2>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        AllYonoUpdate.com records All Yono application changes for general reference. Review the publication
        date, last-reviewed date, and status label before relying on any feature, menu, setting, or navigation
        update.
      </p>
    </div>
  </section>
</Layout>
