---
import Layout from '../layouts/Layout.astro';

const updateTypes = [
  {
    heading: 'Newly Listed Games',
    body: [
      'This section records titles that have been newly added to the All Yono game list or newly observed inside the application.',
      'A newly listed game should only be marked Confirmed when it has been clearly documented. If it has only been reported or partially observed, use the Being Reviewed label until more information is available.',
    ],
    cta: 'View Newly Listed Games',
    href: '#latest-game-updates',
  },
  {
    heading: 'Game List Changes',
    body: [
      'Game-list changes cover renamed titles, updated categories, moved entries, removed listings, or changes to how a game appears within the wider All Yono directory.',
      'These updates help readers understand whether a game name has changed or whether an older listing has been replaced by a newer entry.',
    ],
    cta: 'View Game List Changes',
    href: '#latest-game-updates',
  },
  {
    heading: 'Availability Notices',
    body: [
      'Some games may appear temporarily unavailable, missing from a category, or affected by a short-term application change. Availability notices should include the date observed and a clear explanation that the status may change later.',
      'Avoid treating a temporary change as permanent unless there is a confirmed notice or repeated evidence over time.',
    ],
    cta: 'View Availability Notices',
    href: '#latest-game-updates',
  },
  {
    heading: 'Upcoming and Under-Review Games',
    body: [
      'This area records games that have been announced, reported, or observed but are not yet fully confirmed in the current All Yono game list.',
      'Posts in this category must clearly show the Being Reviewed label. Readers should not treat these entries as currently available until the status changes to Confirmed.',
    ],
    cta: 'View Upcoming Game Notices',
    href: '#latest-game-updates',
  },
];

const statusLabels = [
  { label: 'Confirmed', body: 'The game listing, update, or change has been clearly documented through a reliable published source or direct observation inside the application.' },
  { label: 'Being Reviewed', body: 'The game has been reported or observed, but the available information is not yet enough to present it as confirmed.' },
  { label: 'Previously Listed', body: 'The game appeared in an earlier recorded list but may no longer be visible in the current version or category layout.' },
];

const relatedCategories = [
  { label: 'Promo Code Status', body: 'Records dated availability and release-period changes.', href: '/promo-code-updates/' },
  { label: 'Events & Notices', body: 'Records scheduled events, maintenance, and temporary platform updates.', href: '/events-notices/' },
  { label: 'App Changes', body: 'Records interface, menu, feature, and navigation changes inside the application.', href: '/app-updates/' },
  { label: 'Latest Updates', body: 'Brings all update categories together in one chronological feed.', href: '/latest-updates/' },
];

const faqs = [
  {
    question: 'How often is the All Yono game list updated?',
    answer: 'The list should be updated whenever a meaningful game change can be documented. Each update must show a publication date and last-reviewed date.',
  },
  {
    question: 'Does a newly listed game remain available permanently?',
    answer: 'Not necessarily. A title can be moved, renamed, temporarily unavailable, or removed later. Review the latest update and current game list before relying on an older notice.',
  },
  {
    question: 'What does "Being Reviewed" mean?',
    answer: 'It means the game has been reported or noticed, but the information still needs verification. Only updates marked Confirmed should be treated as verified records.',
  },
  {
    question: 'Why is a game shown as "Previously Listed"?',
    answer: 'This label is used when a title appeared in an earlier update but may no longer be visible in the current list or application version.',
  },
  {
    question: 'Where can I find non-game updates?',
    answer: 'Use Latest Updates for the full feed, Promo Code Status for release updates, Events & Notices for temporary notices, and App Changes for feature or interface updates.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="All Yono Game Updates: New, Changed & Listed Games"
  description="Browse dated All Yono game updates, including newly listed titles, renamed games, category changes, and availability notices with clear status labels."
  rawTitle
  ogTitle="All Yono Game Updates: New Listings and Game Changes"
  ogDescription="See date-stamped All Yono game updates, including new listings, renamed titles, category changes, and game availability notices."
  robots="index, follow"
  keywords={[
    'all yono game updates',
    'all yono new games',
    'all yono game list updates',
    'all yono latest games',
    'all yono game changes',
    'all yono upcoming games',
    'all yono updated game list',
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-brand-primary sm:text-4xl">All Yono Game Updates</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      All Yono game updates can include new game listings, renamed titles, category changes, temporarily
      unavailable entries, and updates to existing game information. This section records those changes in date
      order, with clear labels that show whether a listing is confirmed, being reviewed, or no longer current.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      Use this feed when you want to know what has changed in the All Yono game list without searching through
      older notices or unrelated app updates.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/latest-updates/" class="rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
        View Latest Updates
      </a>
      <a href="/all-yono-games/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
        Browse Full All Yono Game List
      </a>
    </div>

    <p class="mt-6 max-w-3xl text-sm italic text-slate-500">
      Game listings can change after an update is published. Always review the date and current status shown on
      the individual notice.
    </p>
  </section>

  <section id="latest-game-updates" class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Latest Game Updates</h2>
    <p class="mt-3 text-base leading-7 text-slate-600">
      The newest recorded game changes appear here first, each showing its status, update type, headline,
      summary, publication date, and last-reviewed date.
    </p>

    <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
      <p class="text-base font-semibold text-slate-700">No New Game Changes Recorded</p>
      <p class="mt-2 text-sm leading-6 text-slate-500">
        No new confirmed game-list changes have been recorded at this time. Browse the full game list or review
        earlier notices in the update archive.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href="/all-yono-games/" class="rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
          View All Yono Game List
        </a>
        <a href="/update-archive/" class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
          Open Update Archive
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Browse Game Update Types</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {updateTypes.map((type) => (
        <div class="flex flex-col rounded-lg border border-slate-200 bg-white px-5 py-6">
          <h3 class="text-base font-semibold text-brand-primary">{type.heading}</h3>
          {type.body.map((paragraph) => (
            <p class="mt-2 text-sm leading-6 text-slate-600">{paragraph}</p>
          ))}
          <a href={type.href} class="mt-4 text-sm font-semibold text-brand-accent-strong hover:underline">{type.cta} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Full All Yono Game List</h2>
    <p class="mt-3 text-base leading-7 text-slate-600">
      The complete All Yono game list is maintained separately from this update feed. The game-list section
      shows the current recorded directory, while this page explains what changed and when the change was
      first noted.
    </p>
    <p class="mt-3 text-base leading-7 text-slate-600">
      Use the game list when you need the current overview. Use Game Updates when you need the history behind a
      new, changed, removed, or renamed listing.
    </p>
    <a href="/all-yono-games/" class="mt-4 inline-block rounded-md bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-accent-hover">
      Open All Yono Game List
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">How Game Status Labels Work</h2>

    <dl class="mt-6 space-y-4">
      {statusLabels.map((item) => (
        <div>
          <dt class="text-base font-semibold text-brand-primary">{item.label}</dt>
          <dd class="mt-1 text-base leading-7 text-slate-600">{item.body}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-4 text-base leading-7 text-slate-600">
      These labels should remain visible on every game update card. They help prevent older notices from being
      mistaken for current availability.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Related Update Categories</h2>
    <p class="mt-3 text-base leading-7 text-slate-600">
      Game changes can sometimes appear alongside other platform updates. Browse the related sections when you
      need more context.
    </p>

    <ul class="mt-6 space-y-3">
      {relatedCategories.map((item) => (
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <a href={item.href} class="text-base font-semibold text-brand-accent-strong hover:underline">{item.label}</a>
          <span class="text-base leading-7 text-slate-600">{item.body}</span>
        </li>
      ))}
    </ul>

    <a href="/latest-updates/" class="mt-6 inline-block rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
      View Latest Updates
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-brand-primary">Frequently Asked Questions</h2>
    <div class="mt-6 space-y-6">
      {faqs.map((faq) => (
        <div>
          <h3 class="text-base font-semibold text-brand-primary">{faq.question}</h3>
          <p class="mt-2 text-base leading-7 text-slate-600">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-6 py-6">
      <h2 class="text-lg font-bold text-brand-primary">Important Note</h2>
      <p class="mt-3 text-sm leading-6 text-slate-700">
        AllYonoUpdate.com records game-list changes for general information purposes. Listings, categories, and
        availability can change without notice. Read the date, status label, and last-reviewed information
        before relying on a game update.
      </p>
    </div>
  </section>
</Layout>
